{
	"name": "storyforge",
	"version": "0.16.1",
	"description": "A minimalist novel-writing workspace for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"sync:formatting-contract": "node sync-formatting-contract.mjs",
		"check:formatting-contract": "node sync-formatting-contract.mjs --check",
		"titleforge:coverage": "tsx src/titleforge/tools/genre-coverage.ts",
		"titleforge:pools": "tsx src/titleforge/tools/vocab-pools.ts"
	},
	"license": "MIT",
	"devDependencies": {
		"@codemirror/commands": "6.10.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.2",
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.0",
		"obsidian": "latest",
		"typescript": "^5.4.0",
		"vitest": "^1.4.0"
	},
	"dependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"fflate": "^0.8.3",
		"wink-eng-lite-web-model": "^1.8.1",
		"wink-nlp": "^2.4.0"
	}
}
