{
	"name": "storyforge",
	"version": "0.1.0",
	"description": "storyForge's data core: a plain TypeScript library over a folder of markdown (the standalone app's engine).",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "tsx scripts/check-project.ts",
		"app:vite": "vite",
		"app:vite:build": "vite build",
		"app:dev": "tauri dev",
		"app:build": "tauri build --target universal-apple-darwin"
	},
	"license": "MIT",
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^20.11.0",
		"tsx": "^4.23.15",
		"typescript": "^5.4.0",
		"vite": "^8.3.5",
		"vitest": "^1.4.0"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.4",
		"fflate": "^0.8.3",
		"lucide": "^1.61.0",
		"yaml": "^2.9.1"
	}
}
