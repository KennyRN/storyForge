{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "storyForge",
  "version": "1.5.0",
  "identifier": "io.github.kennyrn.storyforge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run app:vite",
    "beforeBuildCommand": "npm run app:vite:build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "storyForge",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "theme": "Dark",
        "backgroundColor": "#293136"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "Productivity",
    "resources": { "../src/ui/theme/fonts/OFL.txt": "OFL.txt" },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
