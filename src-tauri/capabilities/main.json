{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call this app's own commands, listen for the app's events, close itself, and be dragged or zoomed by its empty top band. Nothing else: no file system, shell, network or dialog permission.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-pick-project",
    "allow-open-recent",
    "allow-remember-project",
    "allow-peek-recent",
    "allow-peek-recent-book",
    "allow-recent-projects",
    "allow-project-info",
    "allow-close-project",
    "allow-scan",
    "allow-stat",
    "allow-read-text",
    "allow-read-binary",
    "allow-read-outside",
    "allow-write-text",
    "allow-write-binary",
    "allow-create-file",
    "allow-create-folder",
    "allow-compare-write",
    "allow-rename",
    "allow-retire",
    "allow-list-temp-leftovers",
    "allow-remove-temp",
    "allow-read-cover",
    "allow-pick-cover",
    "allow-machine-get",
    "allow-machine-set",
    "allow-watch-start",
    "allow-watch-stop",
    "allow-download-placeholder",
    "allow-reveal-in-finder",
    "allow-set-menu-state",
    "allow-quit-ready",
    "allow-close-progress",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
