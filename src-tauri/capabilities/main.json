{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call this app's own commands, listen for the app's events, and close itself. Nothing else: no file system, shell, network or dialog permission.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-pick-project",
    "allow-open-recent",
    "allow-recent-projects",
    "allow-project-info",
    "allow-close-project",
    "allow-scan",
    "allow-stat",
    "allow-read-text",
    "allow-read-binary",
    "allow-read-outside",
    "allow-write-text",
    "allow-write-binary",
    "allow-create-file",
    "allow-create-folder",
    "allow-compare-write",
    "allow-rename",
    "allow-retire",
    "allow-machine-get",
    "allow-machine-set",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy"
  ]
}
